# Allow-list: only the shipped agent package is tracked. Cloned project repos,
# secrets (.env), venvs, and generated folders at the root are ignored automatically.
/*
!/.github/
!/.vscode/
!/tools/
!/scripts/
!/docs/
!/.gitignore
!/.env.example
!/README.md
!/SETUP_GUIDE.md
!/requirements.txt

# Per-user state written by /init-project-profile; only curated profiles are shipped
/.github/project/active-profile.yaml
/.github/project/profiles/*/
!/.github/project/profiles/finance/
!/.github/project/profiles/gravity-os/
/.github/instructions/project-*.instructions.md
!/.github/instructions/project-finance.instructions.md
!/.github/instructions/project-gravity-os.instructions.md

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Local editor and OS noise
.DS_Store
Thumbs.db
